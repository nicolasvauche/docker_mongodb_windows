# Derniere version stable verifiee le 12 novembre 2026.
# Version exacte X.Y.Z ou branche X.Y ; latest et les prereleases sont refuses.
MONGO_VERSION=9.0.8
MONGO_PORT=27017
MONGO_USER=admin
MONGO_DATABASE=app
# init genere un mot de passe aleatoire dans .env, a la ligne MONGO_PASSWORD.
MONGO_PASSWORD=

# Facultatif : retirez le # et choisissez un nom avant le premier start.
# Conservez ensuite ce nom pour retrouver les memes volumes.
# COMPOSE_PROJECT_NAME=mon-cours-mongodb
